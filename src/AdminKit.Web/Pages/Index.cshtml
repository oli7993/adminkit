@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
    var totalOrders = Model.StatusData.Sum(s => s.Value);
}

<div class="page-head">
    <div class="page-head-text">
        <h1>Dashboard</h1>
        <p>Last 30 days, compared with the 30 days before it.</p>
    </div>
    <div class="page-head-actions">
        <a class="btn" href="/Orders?status=Pending">
            <partial name="_Icon" model="@("inbox")" />
            @Model.OpenOrders awaiting action
        </a>
        <a class="btn btn-primary" href="/Orders">
            <partial name="_Icon" model="@("orders")" />
            View all orders
        </a>
    </div>
</div>

<div class="stack">
    <div class="grid grid-kpi">
        @foreach (var kpi in Model.Kpis)
        {
            var delta = kpi.Delta;
            var good = delta is > 0 == kpi.HigherIsBetter;
            var deltaClass = delta is null or 0 ? "delta-flat" : good ? "delta-up" : "delta-down";

            <section class="card kpi">
                <p class="kpi-label">@kpi.Label</p>
                <p class="kpi-value">@kpi.Value</p>
                <p class="kpi-foot">
                    @if (delta is { } value)
                    {
                        <span class="delta @deltaClass">
                            @if (value > 0)
                            {
                                <partial name="_Icon" model="@("arrow-up")" />
                            }
                            else if (value < 0)
                            {
                                <partial name="_Icon" model="@("arrow-down")" />
                            }
                            @Math.Abs(value).ToString("0.#")%
                        </span>
                    }
                    <span>@kpi.Comparison</span>
                </p>

                @if (!string.IsNullOrEmpty(kpi.Sparkline))
                {
                    <svg class="sparkline" viewBox="0 0 180 30" preserveAspectRatio="none" aria-hidden="true">
                        <polyline points="@kpi.Sparkline"
                                  fill="none"
                                  stroke="var(--accent)"
                                  stroke-width="2"
                                  stroke-linecap="round"
                                  stroke-linejoin="round" />
                    </svg>
                }
                else if (kpi.Detail is not null)
                {
                    <p class="kpi-detail">@kpi.Detail</p>
                }
            </section>
        }
    </div>

    <div class="grid grid-charts">
        <section class="card">
            <div class="card-head">
                <h2>Orders by status</h2>
                <span class="muted" style="font-size: var(--fs-sm);">Last 30 days</span>
            </div>
            <div class="card-body">
                <div class="chart chart-donut" data-tooltip>
                    <svg viewBox="0 0 220 220" role="img" aria-label="Doughnut chart of orders by status">
                        @foreach (var segment in Model.StatusSegments)
                        {
                            <path class="chart-mark"
                                  d="@segment.Path"
                                  fill="@segment.Color"
                                  stroke="var(--surface)"
                                  stroke-width="2"
                                  tabindex="0"
                                  role="listitem"
                                  data-tip-label="@segment.Label"
                                  data-tip-value="@segment.Value.ToString("N0") orders (@segment.Share.ToString("P0"))">
                                <title>@segment.Label: @segment.Value.ToString("N0") orders</title>
                            </path>
                        }
                        @Html.Raw($"<text class=\"donut-hole-value\" x=\"110\" y=\"108\" text-anchor=\"middle\">{totalOrders:N0}</text>")
                        @Html.Raw("<text class=\"donut-hole-label\" x=\"110\" y=\"126\" text-anchor=\"middle\">in 30 days</text>")
                    </svg>
                </div>

                <ul class="legend">
                    @foreach (var (label, value, color) in Model.StatusData)
                    {
                        <li class="legend-item">
                            <span class="legend-swatch" style="background: @color" aria-hidden="true"></span>
                            <span>@label</span>
                            <span class="legend-value">@value.ToString("N0")</span>
                        </li>
                    }
                </ul>
            </div>
        </section>

        <section class="card">
            <div class="card-head">
                <h2>Revenue by month</h2>
                <span class="muted" style="font-size: var(--fs-sm);">Last 6 months</span>
            </div>
            <div class="card-body">
                <div class="chart" data-tooltip>
                    <svg viewBox="0 0 460 180" role="img" aria-label="Bar chart of revenue by month">
                        <line class="chart-grid" x1="0" y1="50" x2="460" y2="50" />
                        <line class="chart-grid" x1="0" y1="100" x2="460" y2="100" />
                        <line class="chart-baseline" x1="0" y1="150" x2="460" y2="150" />

                        @foreach (var bar in Model.RevenueBars)
                        {
                            <path class="chart-mark"
                                  d="@bar.Path"
                                  fill="var(--accent)"
                                  tabindex="0"
                                  data-tip-label="@bar.Label"
                                  data-tip-value="@bar.Value.ToString("C0")">
                                <title>@bar.Label: @bar.Value.ToString("C0")</title>
                            </path>
                            @* Razor reserves <text>, so the SVG label is emitted as raw markup. *@
                            @Html.Raw($"<text class=\"chart-axis\" x=\"{ChartMath.N(bar.LabelX)}\" y=\"{ChartMath.N(bar.LabelY + 16)}\" text-anchor=\"middle\">{System.Net.WebUtility.HtmlEncode(bar.Label)}</text>")
                        }
                    </svg>
                </div>

                <details class="chart-table">
                    <summary>View as table</summary>
                    <table class="table">
                        <thead>
                            <tr><th scope="col">Month</th><th scope="col" class="right">Revenue</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var bar in Model.RevenueBars)
                            {
                                <tr>
                                    <td>@bar.Label</td>
                                    <td class="right amount">@bar.Value.ToString("C0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </details>
            </div>
        </section>
    </div>

    <section class="card">
        <div class="card-head">
            <h2>Recent orders</h2>
            <a class="btn btn-sm" href="/Orders">Open orders</a>
        </div>
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Reference</th>
                        <th scope="col">Customer</th>
                        <th scope="col">Placed</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="right">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Recent)
                    {
                        <tr>
                            <td data-label="Reference"><span class="cell-primary">@order.Reference</span></td>
                            <td data-label="Customer">
                                <div class="cell-primary">@order.CustomerName</div>
                                <div class="cell-sub">@order.CustomerEmail</div>
                            </td>
                            <td data-label="Placed" class="nowrap">@order.PlacedOn.ToString("d MMM yyyy")</td>
                            <td data-label="Status"><partial name="_StatusBadge" model="order.Status" /></td>
                            <td data-label="Amount" class="right amount">@order.Amount.ToString("C2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/charts.js" asp-append-version="true"></script>
}
