@page "{id:int}"
@model AdminKit.Web.Pages.Orders.EditModel
@{
    ViewData["Title"] = $"Edit {Model.Order?.Reference}";
    var errors = ViewData.ModelState.Where(e => e.Value?.Errors.Count > 0).ToList();
}

<nav aria-label="Breadcrumb">
    <ol class="breadcrumbs">
        <li><a href="/">Dashboard</a></li>
        <li><a href="/Orders">Orders</a></li>
        <li aria-current="page">@Model.Order?.Reference</li>
    </ol>
</nav>

<div class="page-head">
    <div class="page-head-text">
        <h1>@Model.Order?.Reference</h1>
        <p>Placed by @Model.Order?.CustomerName &middot; @Model.Order?.ItemCount items</p>
    </div>
    <div class="page-head-actions">
        <a class="btn" href="/Orders">
            <partial name="_Icon" model="@("arrow-left")" />
            Back to orders
        </a>
    </div>
</div>

<form method="post" novalidate>
    <section class="card">
        <div class="card-body">
            @if (errors.Count > 0)
            {
                @* One summary at the top, plus a message under each field. *@
                <div class="error-summary" role="alert" style="margin-bottom: var(--s-5);">
                    <h2>We could not save this order</h2>
                    <ul>
                        @foreach (var error in errors.SelectMany(e => e.Value!.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <div class="form-section">
                <div class="form-section-head">
                    <h2>Customer</h2>
                    <p>Who placed the order and where confirmations are sent.</p>
                </div>

                <div class="form-grid">
                    <div class="field">
                        <label class="field-label" for="CustomerName">Customer name</label>
                        <input class="input @(Model.HasError("CustomerName") ? "input-error" : "")"
                               id="CustomerName"
                               name="Input.CustomerName"
                               value="@Model.Input.CustomerName"
                               aria-describedby="CustomerName-error"
                               aria-invalid="@(Model.HasError("CustomerName") ? "true" : null)" />
                        <p class="field-error" id="CustomerName-error">@Model.ErrorsFor("CustomerName").FirstOrDefault()</p>
                    </div>

                    <div class="field">
                        <label class="field-label" for="CustomerEmail">Email</label>
                        <input class="input @(Model.HasError("CustomerEmail") ? "input-error" : "")"
                               id="CustomerEmail"
                               name="Input.CustomerEmail"
                               type="email"
                               value="@Model.Input.CustomerEmail"
                               aria-describedby="CustomerEmail-error"
                               aria-invalid="@(Model.HasError("CustomerEmail") ? "true" : null)" />
                        <p class="field-error" id="CustomerEmail-error">@Model.ErrorsFor("CustomerEmail").FirstOrDefault()</p>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-head">
                    <h2>Order</h2>
                    <p>Totals and where the order sits in the pipeline.</p>
                </div>

                <div class="form-grid">
                    <div class="field">
                        <label class="field-label" for="PlacedOn">Placed on</label>
                        <input class="input @(Model.HasError("PlacedOn") ? "input-error" : "")"
                               id="PlacedOn"
                               name="Input.PlacedOn"
                               type="date"
                               value="@Model.Input.PlacedOn?.ToString("yyyy-MM-dd")"
                               aria-describedby="PlacedOn-error"
                               aria-invalid="@(Model.HasError("PlacedOn") ? "true" : null)" />
                        <p class="field-error" id="PlacedOn-error">@Model.ErrorsFor("PlacedOn").FirstOrDefault()</p>
                    </div>

                    <div class="field">
                        <label class="field-label" for="Amount">Total</label>
                        <input class="input @(Model.HasError("Amount") ? "input-error" : "")"
                               id="Amount"
                               name="Input.Amount"
                               type="number"
                               step="0.01"
                               min="0.01"
                               value="@Model.Input.Amount?.ToString("0.00")"
                               aria-describedby="Amount-hint Amount-error"
                               aria-invalid="@(Model.HasError("Amount") ? "true" : null)" />
                        <p class="field-hint" id="Amount-hint">Excluding delivery, in GBP.</p>
                        <p class="field-error" id="Amount-error">@Model.ErrorsFor("Amount").FirstOrDefault()</p>
                    </div>

                    <div class="field">
                        <label class="field-label" for="Status">Status</label>
                        <select class="select" id="Status" name="Input.Status">
                            @foreach (var status in Enum.GetValues<OrderStatus>())
                            {
                                <option value="@status" selected="@(Model.Input.Status == status)">@status.Label()</option>
                            }
                        </select>
                    </div>

                    <div class="field span-all">
                        <label class="field-label" for="Note">Internal note</label>
                        <textarea class="textarea @(Model.HasError("Note") ? "input-error" : "")"
                                  id="Note"
                                  name="Input.Note"
                                  rows="3"
                                  aria-describedby="Note-hint Note-error">@Model.Input.Note</textarea>
                        <p class="field-hint" id="Note-hint">Visible to staff only. Optional.</p>
                        <p class="field-error" id="Note-error">@Model.ErrorsFor("Note").FirstOrDefault()</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <a class="btn btn-ghost" href="/Orders">Cancel</a>
            <span class="spacer"></span>
            <button type="submit" class="btn btn-primary">
                <partial name="_Icon" model="@("check")" />
                Save changes
            </button>
        </div>
    </section>
</form>
